---
import ColorField from '../ui/ColorField.astro';
import Icon from '../ui/Icon.astro';
import PresetList from './PresetList.astro';
import { defaultPreset, presetIds, presets as themePresets } from '../../lib/theme/presets';
import { DEFAULT_DIAGRAM_FONT_SIZE } from '../../lib/theme/defaults';

interface Props {
  labels: {
    controlSurfaceLabel: string;
    style: string;
    preset: string;
    presetListLabel: string;
    presetLight: string;
    presetDark: string;
    presetTerminal: string;
    presetPaper: string;
    presetArchitecture: string;
    colors: string;
    typography: string;
    background: string;
    exportOptions: string;
    includeSource: string;
    includeSourceHint: string;
    primaryColor: string;
    borderColor: string;
    textColor: string;
    lineColor: string;
    accentColor: string;
    fontFamily: string;
    textSize: string;
    transparent: string;
    resetStyles: string;
  };
}

const { labels } = Astro.props;
const presetLabels = {
  light: labels.presetLight,
  dark: labels.presetDark,
  terminal: labels.presetTerminal,
  paper: labels.presetPaper,
  architecture: labels.presetArchitecture,
};
const presets = presetIds.map((id) => ({
  id,
  label: presetLabels[id],
  colors: [themePresets[id].surface, themePresets[id].primary, themePresets[id].text],
}));
---

<aside class="panel panel--style" aria-labelledby="style-title">
  <div class="panel-head">
    <div>
      <span class="panel-label">{labels.controlSurfaceLabel}</span>
      <h2 id="style-title">{labels.style}</h2>
    </div>
    <span class="panel-meta" data-current-preset>Light</span>
  </div>

  <div class="style-scroll">
    <fieldset class="style-section">
      <legend>{labels.preset}</legend>
      <PresetList presets={presets} ariaLabel={labels.presetListLabel} />
    </fieldset>

    <fieldset class="style-section">
      <legend>{labels.colors}</legend>
      <div class="color-grid">
        <ColorField id="primary-color" label={labels.primaryColor} value={defaultPreset.primary} variable="--diagram-primary" />
        <ColorField id="border-color" label={labels.borderColor} value={defaultPreset.border} variable="--diagram-border" />
        <ColorField id="text-color" label={labels.textColor} value={defaultPreset.text} variable="--diagram-text" />
        <ColorField id="line-color" label={labels.lineColor} value={defaultPreset.line} variable="--diagram-line" />
        <ColorField id="accent-color" label={labels.accentColor} value={defaultPreset.accent} variable="--diagram-accent" />
      </div>
    </fieldset>

    <fieldset class="style-section">
      <legend>{labels.typography}</legend>
      <label class="select-field" for="font-family">
        <span>{labels.fontFamily}</span>
        <select id="font-family" data-font-select>
          <option value="IBM Plex Sans, ui-sans-serif, sans-serif">IBM Plex Sans</option>
          <option value="IBM Plex Mono, ui-monospace, monospace">IBM Plex Mono</option>
          <option value="ui-sans-serif, system-ui, sans-serif">System Sans</option>
          <option value="ui-monospace, SFMono-Regular, monospace">System Mono</option>
        </select>
      </label>
      <label class="range-field" for="text-size">
        <span>{labels.textSize}<output data-text-size>{DEFAULT_DIAGRAM_FONT_SIZE}px</output></span>
        <input id="text-size" type="range" min="12" max="22" value={String(DEFAULT_DIAGRAM_FONT_SIZE)} step="1" data-text-size-input />
      </label>
    </fieldset>

    <fieldset class="style-section">
      <legend>{labels.background}</legend>
      <label class="toggle-field" for="transparent-background">
        <span>{labels.transparent}</span>
        <input id="transparent-background" type="checkbox" data-transparent-toggle />
        <span class="toggle-track" aria-hidden="true"><span></span></span>
      </label>
    </fieldset>

    <fieldset class="style-section">
      <legend>{labels.exportOptions}</legend>
      <label class="toggle-field" for="include-source">
        <span class="toggle-field__copy">
          <span>{labels.includeSource}</span>
          <small>{labels.includeSourceHint}</small>
        </span>
        <input id="include-source" type="checkbox" data-include-source-toggle />
        <span class="toggle-track" aria-hidden="true"><span></span></span>
      </label>
    </fieldset>

    <button class="reset-button" type="button" data-reset-styles>
      <Icon name="reset" />
      <span>{labels.resetStyles}</span>
    </button>
  </div>
</aside>
