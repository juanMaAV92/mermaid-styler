---
interface Props {
  source: string;
  sourceHint: string;
  placeholder: string;
  labels: {
    inputLabel: string;
    source: string;
    sourceCount: string;
    renderLater: string;
    errorDetails: string;
    errorFallback: string;
    goToLine: string;
  };
}

const { source, sourceHint, placeholder, labels } = Astro.props;
---

<section class="panel panel--editor" aria-labelledby="source-title">
  <div class="panel-head">
    <div>
      <span class="panel-label">{labels.inputLabel}</span>
      <h2 id="source-title">{labels.source}</h2>
    </div>
    <span class="panel-meta" data-source-count>0 {labels.sourceCount}</span>
  </div>
  <div class="source-feedback" id="source-feedback" data-source-feedback hidden>
    <strong data-source-feedback-title>{labels.errorDetails}</strong>
    <pre class="source-feedback__body" data-source-feedback-body>{labels.errorFallback}</pre>
    <button type="button" class="source-feedback__action" data-go-to-line hidden></button>
  </div>
  <div class="editor-wrap">
    <textarea
      id="mermaid-source"
      class="source-input"
      name="mermaid-source"
      spellcheck="false"
      autocomplete="off"
      autocapitalize="off"
      data-source-input
      aria-labelledby="source-title"
      aria-describedby="source-hint"
      placeholder={placeholder}
    >{source}</textarea>
  </div>
  <div class="panel-foot">
    <span id="source-hint">{sourceHint}</span>
    <span class="keyboard-hint"><kbd>⌘</kbd><kbd>↵</kbd> {labels.renderLater}</span>
  </div>
</section>
