{
  "name": "mermaid-styler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-notices.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "preview": "astro preview",
    "check:bundle": "node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --project=chromium",
    "pretest:e2e:cross-browser": "npm run build",
    "test:e2e:cross-browser": "playwright test --project=firefox --project=webkit"
  },
  "dependencies": {
    "astro": "7.3.5",
    "dompurify": "3.4.16",
    "mermaid": "11.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "happy-dom": "^20.14.5",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
