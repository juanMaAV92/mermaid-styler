---
interface Props {
  title: string;
  hint: string;
  labels: {
    artifactStageLabel: string;
    preview: string;
    emptyState: string;
    renderingState: string;
    readyState: string;
    invalidState: string;
    invalidStateHint: string;
    timeoutState: string;
    timeoutStateHint: string;
    sourceAlternative: string;
    previewNavigation: string;
    zoomOut: string;
    zoomIn: string;
    fitPreview: string;
    zoomLevel: string;
    panHint: string;
  };
}

const { title, hint, labels } = Astro.props;
---

<section class="panel panel--artifact" aria-labelledby="preview-title">
  <div class="panel-head panel-head--light">
    <div>
      <span class="panel-label">{labels.artifactStageLabel}</span>
      <h2 id="preview-title">{labels.preview}</h2>
    </div>
    <span class="stage-status" data-stage-status role="status">{title}</span>
  </div>
  <div class="artifact-stage" data-artifact-stage data-render-state="ready" aria-describedby="preview-status">
    <div class="stage-surface">
      <div class="stage-state stage-state--empty" data-state-view="empty" hidden>
        <span class="stage-state__mark" aria-hidden="true">+</span>
        <strong>{labels.emptyState}</strong>
      </div>
      <div class="stage-state stage-state--rendering" data-state-view="rendering" hidden aria-live="polite">
        <span class="stage-loader" aria-hidden="true"></span>
        <strong>{labels.renderingState}</strong>
      </div>
      <div class="stage-notice stage-notice--error" data-state-notice="error" hidden role="alert">
        <strong>{labels.invalidState}</strong>
        <span>{labels.invalidStateHint}</span>
      </div>
      <div class="stage-notice stage-notice--timeout" data-state-notice="timeout" hidden role="alert">
        <strong>{labels.timeoutState}</strong>
        <span>{labels.timeoutStateHint}</span>
      </div>
      <div class="stage-state stage-state--ready" data-state-view="ready">
        <div class="preview-viewport" data-preview-viewport tabindex="0" role="region" aria-label={labels.previewNavigation}>
          <div class="preview-layer" data-preview-layer>
            <div class="scaffold-preview" data-scaffold-preview>
              <svg class="sample-diagram" viewBox="0 0 760 430" role="img" aria-labelledby="sample-title sample-description">
                <title id="sample-title">Example artifact diagram</title>
                <desc id="sample-description">A sample flow from source to renderer to shareable artifact.</desc>
                <path class="diagram-line" d="M239 214h86m110 0h86" />
                <path class="diagram-arrow" d="m314 205 12 9-12 9m110-18 12 9-12 9" />
                <rect class="diagram-node" x="72" y="166" width="167" height="96" rx="8" />
                <rect class="diagram-node diagram-node--accent" x="325" y="166" width="110" height="96" rx="8" />
                <rect class="diagram-node" x="521" y="166" width="167" height="96" rx="8" />
                <circle class="diagram-port" cx="239" cy="214" r="4" />
                <circle class="diagram-port" cx="325" cy="214" r="4" />
                <circle class="diagram-port" cx="435" cy="214" r="4" />
                <circle class="diagram-port" cx="521" cy="214" r="4" />
                <text class="diagram-label diagram-label--small" x="155.5" y="198" text-anchor="middle">SOURCE</text>
                <text class="diagram-label" x="155.5" y="228" text-anchor="middle">Mermaid code</text>
                <text class="diagram-label diagram-label--small" x="380" y="198" text-anchor="middle">STYLE</text>
                <text class="diagram-label" x="380" y="228" text-anchor="middle">Theme</text>
                <text class="diagram-label diagram-label--small" x="604.5" y="198" text-anchor="middle">OUTPUT</text>
                <text class="diagram-label" x="604.5" y="228" text-anchor="middle">Shareable SVG</text>
                <text class="diagram-note" x="380" y="334" text-anchor="middle">Proof bench preview</text>
              </svg>
            </div>
            <div class="rendered-diagram" data-svg-host hidden aria-live="off"></div>
          </div>
          <span class="preview-pan-hint">{labels.panHint}</span>
        </div>
        <div class="preview-controls" data-preview-controls aria-label={labels.previewNavigation}>
          <button class="preview-control" type="button" data-preview-action="zoom-out" aria-label={labels.zoomOut}>−</button>
          <output class="preview-zoom" data-preview-zoom aria-label={labels.zoomLevel} aria-live="polite">100%</output>
          <button class="preview-control" type="button" data-preview-action="zoom-in" aria-label={labels.zoomIn}>+</button>
          <span class="preview-control-divider" aria-hidden="true"></span>
          <button class="preview-fit" type="button" data-preview-action="fit">{labels.fitPreview}</button>
        </div>
      </div>
      <div class="stage-caption" id="preview-status" aria-live="polite">
        <span class="caption-mark" aria-hidden="true"></span>
        <span data-stage-caption-text>{hint}</span>
      </div>
      <p class="stage-alternative">{labels.sourceAlternative}</p>
    </div>
  </div>
</section>
